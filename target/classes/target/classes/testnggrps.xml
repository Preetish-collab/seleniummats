<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="TestSuite" parallel="false" thread-count="4">
    <test name="GroupsTest">
        <groups>
            <define name="supergroups">
                <include name="smoke.*"/>
                <include name="regression.*"/>
            </define>
            <run>
                <include name="supergroups">
                </include>
            </run>
        </groups>
        <classes>
           <class name="seleniumprac.TestNGGroups"/>

        </classes>
    </test>
</suite>