<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="parameters">
    <test name="chrome browser test" parallel="false">
        <parameter name="browsername" value="chrome"/>
        <classes>
            <class name="seleniumprac.BrowserParameterization"/>
        </classes>
    </test>

    <test name="edge browser test" parallel="false">
        <parameter name="browsername" value="edge"/>
        <classes>
            <class name="seleniumprac.BrowserParameterization"/>
        </classes>
    </test>

    <test name="firefox browser test" parallel="false">
        <parameter name="browsername" value="firefox"/>
        <classes>
            <class name="seleniumprac.BrowserParameterization"/>

        </classes>
    </test>
</suite>